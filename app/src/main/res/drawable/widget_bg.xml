<?xml version="1.0" encoding="utf-8"?>
<!-- The keeper's room at night: deep violet into black, a faint edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F21C1733" android:centerColor="#F2120F21" android:endColor="#F20A0912" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#33E8C27A" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
